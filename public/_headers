# Cloudflare Pages response headers (not served itself). Rules that match one path add up, and a
# header set by two rules is joined with a comma, so Cache-Control is set by exactly one rule each.
# The e2e preview server applies this file too (tests/e2e/helpers/pwa-site.ts).

# The CSP is enforced. The e2e offline spec runs the production build under it (boot, sound, a box,
# the lantern, the update path, workers) and sees only UIKit's zod checking once whether eval works,
# which it catches. Check the Quest Browser and Quest app consoles once on a headset (remote debugging:
# "Refused to" lines); if something breaks there, rename the header to
# Content-Security-Policy-Report-Only and redeploy (and switch the check in scripts/deploy-pages.sh
# and tests/unit/pages-headers.test.ts back).
# worker-src has no data:. IWSDK's locomotion worker loads from a data: URL, so turning locomotion on
# (it is off in iwsdk.config.json) would need data: in worker-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; media-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
  Permissions-Policy: xr-spatial-tracking=(self), camera=(), microphone=(), geolocation=(), usb=(), serial=(), bluetooth=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Hashed bundles never change under one name, but this rule also covers a missing /assets/ URL (a
# chunk of another deploy): a year-long or immutable 404 could break a rollback or keep the precache
# install failing. A day is plenty; the service worker's precache serves these anyway.
/assets/*
  Cache-Control: public, max-age=86400

# Always ask the server, so a new version is found on the next launch.
# (Pages redirects /index.html to /, so / is the rule for the page.)
/
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# The Quest app checks these at launch.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

# The judge host is unlisted (Devpost and the tester only): keep it out of search. It is a production deploy, so Pages
# adds no noindex of its own (it does on preview aliases). Only that host: the public host must stay indexable, and
# scripts/deploy-pages.sh checks both.
https://shadowlocks-judge.pages.dev/*
  X-Robots-Tag: noindex
